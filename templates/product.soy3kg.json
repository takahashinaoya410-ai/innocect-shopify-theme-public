    "faq-12": {
      "type": "faq",
      "blocks": {
        "faq42": {
          "type": "qa",
          "settings": {
            "question": "牛乳アレルギーですが、飲めますか？",
            "answer": "リッチチョコレート・カフェオレ・ミルクティー風味には、乳成分を含む原料（クリーミングパウダー）を使用しています。アレルギーが心配な方は原材料をご確認のうえ、医師にご相談ください。"
          }
        },
        "faq43": {
          "type": "qa",
          "settings": {
            "question": "どのくらいの頻度で飲めばいいですか？",
            "answer": "1日1〜2杯を目安に、朝食代わりや間食代わりとして飲まれる方が多いです。無理のない範囲で習慣にするのがおすすめです。"
          }
        },
        "faq44": {
          "type": "qa",
          "settings": {
            "question": "原産国はどこですか？",
            "answer": "国内製造・中国製造の大豆たんぱくを使用しています。製品の混合・充填・配送は、すべて国内の工場で行っています。"
          }
        },
        "faq45": {
          "type": "qa",
          "settings": {
            "question": "大豆イソフラボンはどのくらい入っていますか？",
            "answer": "製品ロットによってばらつきがありますが、1回分（約30g）あたり、おおよそ25〜60mg前後のイソフラボンが含まれています。"
          }
        },
        "faq46": {
          "type": "qa",
          "settings": {
            "question": "保存料は入っていますか？",
            "answer": "保存料は使用していません。"
          }
        },
        "faq47": {
          "type": "qa",
          "settings": {
            "question": "1杯あたりのたんぱく質量は？",
            "answer": "フレーバーによって異なりますが、1杯30gあたり20.2〜21.8gのたんぱく質を含みます（リッチチョコレート・カフェオレ・ミルクティー風味）。"
          }
        }
      },
