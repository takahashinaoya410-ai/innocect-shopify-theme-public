{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>ギフトカード | {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="container container--form section empty-state">
      <span class="logo-text">{{ shop.name }}</span>
      <h1 class="page-title">ギフトカード</h1>
      <p class="num" style="font-size: 32px; font-weight: 800;">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}<p class="form-error">このギフトカードは使用できません</p>{%- endif -%}
      <p>コード：<span class="num">{{ gift_card.code | format_code }}</span></p>
      {%- if gift_card.expires_on -%}<p>有効期限：{{ gift_card.expires_on | date: '%Y/%m/%d' }}</p>{%- endif -%}
      <div class="btn-row btn-row--center"><a class="btn btn--primary" href="{{ shop.url }}">お買い物をする</a></div>
    </main>
  </body>
</html>
