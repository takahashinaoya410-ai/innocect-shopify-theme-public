    "faq-10": {
      "type": "faq",
      "blocks": {
        "faq33": {
          "type": "qa",
          "settings": {
            "question": "牛乳アレルギーですが、飲めますか？",
            "answer": "リッチチョコレート風味・生キャラメル風味には乳成分を含む原料を使用しています。黒蜜きなこ風味のアレルギー物質は大豆のみです。アレルギーが心配な方は原材料をご確認のうえ、医師にご相談ください。"
          }
        },
        "faq34": {
          "type": "qa",
          "settings": {
            "question": "人工甘味料は入っていますか？",
            "answer": "フレーバーつきの商品には、スクラロース・アセスルファムKなどの甘味料を使用しています（黒蜜きなこ風味はアスパルテーム・L-フェニルアラニン化合物も使用）。気になる方はプレーン、または「ソイプロテイン 3kg 人工甘味料不使用」をお選びください。"
          }
        },
        "faq35": {
          "type": "qa",
          "settings": {
            "question": "ビタミン11種の内容は？",
            "answer": "ビタミンC、ビタミンE、ナイアシン、パントテン酸、ビタミンB1、ビタミンB6、ビタミンB2、ビタミンA、葉酸、ビタミンD、ビタミンB12の11種です。"
          }
        },
        "faq36": {
          "type": "qa",
          "settings": {
            "question": "どのくらいの頻度で飲めばいいですか？",
            "answer": "1日1〜2杯を目安に、朝食代わりや間食代わりとして飲まれる方が多いです。"
          }
        },
        "faq37": {
          "type": "qa",
          "settings": {
            "question": "原産国はどこですか？",
            "answer": "国内製造・中国製造の大豆たんぱくを使用し、国内工場で製造しています。"
          }
        }
      },
