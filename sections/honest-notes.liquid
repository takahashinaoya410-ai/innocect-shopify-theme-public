<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--text">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <ul class="honest" role="list">
      {%- for block in section.blocks -%}
        <li class="honest__item card" {{ block.shopify_attributes }}>
          <h3 class="honest__title">{{ block.settings.title }}</h3>
          <p class="honest__text">{{ block.settings.text }}</p>
          {%- if block.settings.tip != blank -%}<p class="honest__tip">{% render 'icon', name: 'check', size: 18, stroke: 2.2 %}<span>{{ block.settings.tip }}</span></p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "購入前に知っておいてほしいこと",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "en",
      "label": "英字の小見出し",
      "default": "BEFORE YOU BUY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "購入前に知っておいてほしいこと"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "リード文"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "default": "surface",
      "options": [
        {
          "value": "white",
          "label": "白"
        },
        {
          "value": "surface",
          "label": "グレー"
        },
        {
          "value": "tint",
          "label": "淡いグリーン"
        },
        {
          "value": "dark",
          "label": "濃い色"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ページ内リンク用ID",
      "info": "例：reviews（半角英数字）"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "項目",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "見出し",
          "default": "見出し"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "説明"
        },
        {
          "type": "text",
          "id": "tip",
          "label": "対処法"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "購入前に知っておいてほしいこと",
      "blocks": [
        {
          "type": "note"
        },
        {
          "type": "note"
        }
      ]
    }
  ]
}
{% endschema %}
