<div class="container section">
  <h1 class="page-title">マイページ</h1>
  <p>{{ customer.last_name }} {{ customer.first_name }} 様　<a href="{{ routes.account_logout_url }}">ログアウト</a></p>
  <div class="account-grid">
    <div>
      <h2 class="h3">注文履歴</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-wrap">
            <table class="spec-table">
              <thead><tr><th scope="col">注文番号</th><th scope="col">日付</th><th scope="col">状況</th><th scope="col">合計</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%Y/%m/%d' }}</td><td>{{ order.fulfillment_status_label }}</td><td class="num">{{ order.total_price | money }}</td></tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p>まだ注文はありません。</p>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <div class="card">
      <h2 class="h3">お届け先</h2>
      {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
      <p><a href="{{ routes.account_addresses_url }}">お届け先を管理（{{ customer.addresses_count }}件）</a></p>
      <p class="note">定期便のスキップ・解約は、定期便アプリのマイページから行えます。</p>
    </div>
  </div>
</div>
{% schema %}
{ "name": "マイページ", "settings": [] }
{% endschema %}
