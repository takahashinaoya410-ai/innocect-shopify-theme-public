<section class="hero section--{{ section.settings.background }}">
  <div class="container hero__inner">
    <div class="hero__text">
      {%- if section.settings.badge != blank -%}<span class="badge badge--line">{{ section.settings.badge }}</span>{%- endif -%}
      <h1 class="hero__title"><span class="hero__line">{{ section.settings.heading }}</span>{% if section.settings.heading_accent != blank %}<span class="hero__accent">{{ section.settings.heading_accent }}</span>{% endif %}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="btn-row">
        {%- if section.settings.button_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
      {%- if section.settings.price_note != blank -%}<p class="hero__price">{{ section.settings.price_note }}</p>{%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 560px, 100vw', fetchpriority: 'high', alt: section.settings.heading }}
      {%- else -%}
        <div class="hero__pouches" aria-hidden="true">
          <span class="pouch pouch--tilt-l" style="--pouch: #3E2419;"><span class="pouch__brand">INNOCECT</span><span class="pouch__name">WHEY PROTEIN</span></span>
          <span class="pouch pouch--lg" style="--pouch: #4A2C1F;"><span class="pouch__brand">INNOCECT</span><span class="pouch__name">SOY PROTEIN</span></span>
          <span class="pouch pouch--tilt-r" style="--pouch: #141619;"><span class="pouch__brand">INNOCECT</span><span class="pouch__name">EAA</span></span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "メインビジュアル",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "上の小さなラベル",
      "default": "INNOCECT 公式オンラインストア"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "毎日続けるものだから、"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "見出し（色つき部分）",
      "default": "低価格×高品質。"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "リード文",
      "default": "INNOCECTは、余計なコストを徹底的に削減する国内ニュートリションブランドです。プロテイン・アミノ酸・食物繊維を、続けやすい価格でお届けします。"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタン1",
      "default": "人気の商品を見る"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "ボタン1のリンク"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "ボタン2",
      "default": "はじめての方へ"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "ボタン2のリンク"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "価格の一言",
      "default": "ソイプロテイン3kgなら、1杯 約[◯]円から"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像（未設定なら仮パッケージ）"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "default": "surface",
      "options": [
        {
          "value": "white",
          "label": "白"
        },
        {
          "value": "surface",
          "label": "グレー"
        },
        {
          "value": "tint",
          "label": "淡いグリーン"
        },
        {
          "value": "dark",
          "label": "濃い色"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "メインビジュアル"
    }
  ]
}
{% endschema %}
