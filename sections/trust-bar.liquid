<section class="section section--compact section--{{ section.settings.background }}">
  <div class="container">
    <ul class="trust" role="list">
      {%- for block in section.blocks -%}
        <li class="trust__item" {{ block.shopify_attributes }}>
          <span class="icon-circle">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          <span class="trust__text">
            <span class="trust__title">{% render 'tokens', text: block.settings.title, product: product %}</span>
            {%- if block.settings.text != blank -%}<span class="trust__sub">{% render 'tokens', text: block.settings.text, product: product %}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

