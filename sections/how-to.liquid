<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--medium">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <ol class="steps" role="list">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          {%- assign n = n | plus: 1 -%}
          <li class="step card" {{ block.shopify_attributes }}>
            <span class="step__no num">STEP {{ n }}</span>
            <span class="icon-circle icon-circle--lg">{% render 'icon', name: block.settings.icon, size: 32 %}</span>
            <span class="step__title">{{ block.settings.title }}</span>
            <span class="step__text">{{ block.settings.text }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>
    {%- if section.settings.tip != blank -%}
      <p class="tip">{% render 'icon', name: 'info', size: 20 %}<span><b>{{ section.settings.tip_label }}</b>{{ section.settings.tip }}</span></p>
    {%- endif -%}
    {%- assign arranges = section.blocks | where: 'type', 'arrange' -%}
    {%- if arranges.size > 0 -%}
      <div class="arranges">
        {%- for block in arranges -%}
          <div class="arrange card" {{ block.shopify_attributes }}><span class="arrange__title">{{ block.settings.title }}</span><span class="arrange__text">{{ block.settings.text }}</span></div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

