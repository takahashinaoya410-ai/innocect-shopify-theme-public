<div class="container container--form section empty-state">
  <span class="logo-text">INNOCECT</span>
  <h1 class="page-title">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  <div class="card form-card">
    {%- form 'storefront_password', class: 'form-stack' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span>パスワード</span><input class="input" type="password" name="password" autocomplete="current-password" required></label>
      <button class="btn btn--primary btn--block" type="submit">入る</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "パスワードページ", "settings": [{ "type": "text", "id": "heading", "label": "見出し", "default": "まもなくオープンします" }] }
{% endschema %}
