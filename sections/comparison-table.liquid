<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--narrow">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    {%- liquid
      assign hl = section.settings.highlight_column
      assign head = section.settings.header | split: '|'
    -%}
    <div class="table-wrap">
      <table class="cmp-table" style="min-width: {{ section.settings.min_width }}px;">
        <thead>
          <tr>
            {%- for cell in head -%}<th scope="col"{% if forloop.index0 == hl and hl > 0 %} class="is-hl"{% endif %}>{{ cell | strip }}</th>{%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign cells = block.settings.cells | split: '|' -%}
            <tr {{ block.shopify_attributes }}>
              {%- for cell in cells -%}
                {%- if forloop.first -%}<th scope="row">{{ cell | strip }}</th>{%- else -%}<td{% if forloop.index0 == hl and hl > 0 %} class="is-hl"{% endif %}>{{ cell | strip }}</td>{%- endif -%}
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.note != blank -%}<p class="note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "比較表",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "en",
      "label": "英字の小見出し",
      "default": "COMPARE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "比べてみると"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "リード文"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "白"
        },
        {
          "value": "surface",
          "label": "グレー"
        },
        {
          "value": "tint",
          "label": "淡いグリーン"
        },
        {
          "value": "dark",
          "label": "濃い色"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ページ内リンク用ID",
      "info": "例：reviews（半角英数字）"
    },
    {
      "type": "text",
      "id": "header",
      "label": "見出し行（| で区切る）",
      "default": "|A|B"
    },
    {
      "type": "range",
      "id": "highlight_column",
      "label": "強調する列（0＝なし）",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "min_width",
      "label": "表の最小幅（スマホで横スクロール）",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 520,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "注記"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "行",
      "settings": [
        {
          "type": "text",
          "id": "cells",
          "label": "セル（| で区切る）",
          "default": "項目|値|値"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "比較表",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
