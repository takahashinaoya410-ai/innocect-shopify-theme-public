<div class="container container--form section">
  <h1 class="page-title">パスワードの再設定</h1>
  <div class="card form-card">
    {%- form 'reset_customer_password', class: 'form-stack' -%}
      {{ form.errors | default_errors }}
      <label class="field"><span>新しいパスワード</span><input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="field"><span>新しいパスワード（確認）</span><input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button class="btn btn--primary btn--block" type="submit">再設定する</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "パスワード再設定", "settings": [] }
{% endschema %}
