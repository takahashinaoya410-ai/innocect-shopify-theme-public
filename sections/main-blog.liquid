<div class="container section">
  <h1 class="page-title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a class="article-card card" href="{{ article.url }}">
          {%- if article.image -%}{{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 360px, 100vw', alt: article.title }}{%- endif -%}
          <span class="article-card__date num">{{ article.published_at | date: '%Y.%m.%d' }}</span>
          <span class="article-card__title">{{ article.title }}</span>
          <span class="article-card__text">{{ article.excerpt_or_content | strip_html | truncate: 70 }}</span>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "ブログ", "settings": [] }
{% endschema %}
