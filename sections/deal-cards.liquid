<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--medium">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <div class="deals">
      {%- for block in section.blocks -%}
        <div class="deal card" {{ block.shopify_attributes }}>
          <div class="deal__head"><span class="icon-circle icon-circle--fill">{% render 'icon', name: block.settings.icon, size: 22 %}</span><span class="deal__title">{{ block.settings.title }}</span></div>
          <p class="deal__big">{{ block.settings.highlight }}</p>
          <ul class="checklist" role="list">
            {%- assign lines = block.settings.points | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: 'check', size: 18, stroke: 2.2 %}<span>{{ l }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- if block.settings.link != blank -%}<a class="deal__link" href="{{ block.settings.link }}">詳しく見る{% render 'icon', name: 'chev', size: 16 %}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

