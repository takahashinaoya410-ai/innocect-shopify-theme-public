<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--wide">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <div class="reasons">
      {%- for block in section.blocks -%}
        <article class="reason card" {{ block.shopify_attributes }}>
          <div class="reason__top">
            <span class="reason__num num">#{{ block.settings.number }}</span>
            <span class="icon-circle icon-circle--sm">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
          </div>
          <h3 class="reason__title">{{ block.settings.title }}</h3>
          {%- if block.settings.big != blank -%}
            <p class="reason__big"><span class="num">{% render 'tokens', text: block.settings.big, product: product %}</span><span class="reason__big-sub">{% render 'tokens', text: block.settings.big_sub, product: product %}</span></p>
          {%- endif -%}
          <p class="reason__body">{% render 'tokens', text: block.settings.body, product: product %}</p>
          {%- if block.settings.bullets != blank -%}
            <ul class="checklist" role="list">
              {%- assign lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{% render 'icon', name: 'check', size: 18, stroke: 2.2 %}<span>{{ l }}</span></li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

