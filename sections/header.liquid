{%- liquid
  assign menu = section.settings.menu
-%}
<header class="site-header" data-header>
  <div class="site-header__inner container">
    <details class="drawer sp-only" data-drawer>
      <summary class="icon-btn" aria-label="メニューを開く">{% render 'icon', name: 'menu', size: 24 %}</summary>
      <div class="drawer__panel">
        <div class="drawer__head">
          <span class="logo-text">{{ section.settings.logo_text }}</span>
          <button type="button" class="icon-btn" data-drawer-close aria-label="メニューを閉じる">{% render 'icon', name: 'close', size: 22 %}</button>
        </div>
        <nav aria-label="メニュー">
          <ul class="drawer__list" role="list">
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}{% render 'icon', name: 'chev', size: 18 %}</a>
                {%- if link.links.size > 0 -%}
                  <ul class="drawer__sub" role="list">
                    {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- if shop.customer_accounts_enabled -%}
          <a class="btn btn--outline btn--block" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}">{% render 'icon', name: 'user', size: 18 %}{% if customer %}マイページ{% else %}ログイン{% endif %}</a>
        {%- endif -%}
      </div>
    </details>

    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }} トップへ">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: height: section.settings.logo_height, alt: shop.name, class: 'logo__img', preload: true }}
      {%- else -%}
        <span class="logo-text">{{ section.settings.logo_text }}</span>
      {%- endif -%}
      {%- if section.settings.logo_sub != blank -%}<span class="logo__sub">{{ section.settings.logo_sub }}</span>{%- endif -%}
    </a>

    <nav class="site-nav pc-only" aria-label="メインメニュー">
      <ul class="site-nav__list" role="list">
        {%- for link in menu.links -%}
          <li class="site-nav__item">
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="site-nav__dropdown" role="list">
                {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      <details class="search-pop" data-search>
        <summary class="icon-btn" aria-label="商品を検索">{% render 'icon', name: 'search', size: 22 %}</summary>
        <form class="search-pop__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="HeaderSearch">商品を検索</label>
          <input id="HeaderSearch" class="input" type="search" name="q" placeholder="商品名・フレーバーで検索" value="{{ search.terms | escape }}">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="btn btn--primary btn--sm">検索</button>
        </form>
      </details>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn pc-only" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" aria-label="マイページ">{% render 'icon', name: 'user', size: 22 %}</a>
      {%- endif -%}
      <a class="icon-btn cart-link" href="{{ routes.cart_url }}" aria-label="カート（{{ cart.item_count }}点）" data-cart-link>
        {% render 'icon', name: 'cart', size: 23 %}
        <span class="cart-bubble num" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "ヘッダー",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "ロゴ画像", "info": "未設定ならテキストのロゴを表示します" },
    { "type": "range", "id": "logo_height", "label": "ロゴの高さ", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 28 },
    { "type": "text", "id": "logo_text", "label": "テキストロゴ", "default": "INNOCECT" },
    { "type": "text", "id": "logo_sub", "label": "ロゴ横の小さな文字", "default": "公式ストア" },
    { "type": "link_list", "id": "menu", "label": "メニュー", "default": "main-menu" }
  ]
}
{% endschema %}
