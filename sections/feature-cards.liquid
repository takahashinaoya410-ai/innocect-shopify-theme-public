<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--medium">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <div class="features features--{{ section.settings.style }}">
      {%- for block in section.blocks -%}
        <div class="feature card" {{ block.shopify_attributes }}>
          {%- if section.settings.style == 'scene' -%}
            <div class="feature__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 320px, 100vw', alt: block.settings.title }}
              {%- else -%}
                <span class="feature__ph">{% render 'icon', name: block.settings.icon, size: 30 %}</span>
              {%- endif -%}
            </div>
          {%- else -%}
            <span class="icon-circle">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          {%- endif -%}
          <div class="feature__body">
            <h3 class="feature__title">{{ block.settings.title }}</h3>
            <p class="feature__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

