<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--wide">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    {%- if section.settings.products != blank -%}
      <div class="product-grid product-grid--center">
        {%- for p in section.settings.products -%}{% render 'card-product', product: p %}{%- endfor -%}
      </div>
    {%- elsif recommendations.performed and recommendations.products_count > 0 -%}
      <div class="product-grid product-grid--center">
        {%- for p in recommendations.products -%}{% render 'card-product', product: p %}{%- endfor -%}
      </div>
    {%- elsif product -%}
      <div class="product-grid product-grid--center" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related"></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "おすすめ商品",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "en",
      "label": "英字の小見出し",
      "default": "RECOMMEND"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "一緒に選ばれているアイテム"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "リード文"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "白"
        },
        {
          "value": "surface",
          "label": "グレー"
        },
        {
          "value": "tint",
          "label": "淡いグリーン"
        },
        {
          "value": "dark",
          "label": "濃い色"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ページ内リンク用ID",
      "info": "例：reviews（半角英数字）"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "表示する商品",
      "limit": 6,
      "info": "未選択ならShopifyの自動おすすめを表示します"
    }
  ],
  "presets": [
    {
      "name": "おすすめ商品"
    }
  ]
}
{% endschema %}
