<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--text">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <ul class="why" role="list">
      {%- for block in section.blocks -%}
        <li class="why__item" {{ block.shopify_attributes }}>
          <span class="icon-circle icon-circle--dark">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          <div><h3 class="why__title">{{ block.settings.title }}</h3><p class="why__text">{{ block.settings.text }}</p></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
