<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--wide">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <div class="flavors">
      {%- for block in section.blocks -%}
        <article class="flavor card" {{ block.shopify_attributes }}>
          <div class="flavor__media" style="background: {{ block.settings.color }};">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- endif -%}
          </div>
          <div class="flavor__body">
            <div class="flavor__head"><h3 class="flavor__name">{{ block.settings.name }}</h3>{%- if block.settings.tag != blank -%}<span class="badge badge--accent">{{ block.settings.tag }}</span>{%- endif -%}</div>
            {%- if block.settings.catch != blank -%}<p class="flavor__catch">{{ block.settings.catch }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="flavor__text">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.mix != blank -%}<p class="flavor__mix"><b>おすすめの割り方：</b>{{ block.settings.mix }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "フレーバーガイド",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "en",
      "label": "英字の小見出し",
      "default": "FLAVOR"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し",
      "default": "選べるフレーバー"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "リード文"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "default": "surface",
      "options": [
        {
          "value": "white",
          "label": "白"
        },
        {
          "value": "surface",
          "label": "グレー"
        },
        {
          "value": "tint",
          "label": "淡いグリーン"
        },
        {
          "value": "dark",
          "label": "濃い色"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ページ内リンク用ID",
      "info": "例：reviews（半角英数字）"
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "フレーバー",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "フレーバー名",
          "default": "フレーバー名"
        },
        {
          "type": "color",
          "id": "color",
          "label": "色",
          "default": "#4A2C1F"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "写真"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "ラベル（NEW・近日発売など）"
        },
        {
          "type": "text",
          "id": "catch",
          "label": "キャッチコピー"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "説明"
        },
        {
          "type": "text",
          "id": "mix",
          "label": "おすすめの割り方"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "フレーバーガイド",
      "blocks": [
        {
          "type": "flavor"
        },
        {
          "type": "flavor"
        }
      ]
    }
  ]
}
{% endschema %}
