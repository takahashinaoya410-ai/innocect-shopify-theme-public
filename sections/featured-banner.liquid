{%- assign p = section.settings.product -%}
<section class="section section--compact">
  <div class="container">
    <a class="feature-banner" href="{{ p.url | default: '#' }}" style="--fb-bg: {{ section.settings.bg_color }}; --fb-accent: {{ section.settings.accent_color }};">
      <div class="feature-banner__text">
        {%- if section.settings.label != blank -%}<span class="feature-banner__label num">{{ section.settings.label }}</span>{%- endif -%}
        <h2 class="feature-banner__title">{{ section.settings.heading }}</h2>
        <p class="feature-banner__lead">{{ section.settings.text }}</p>
        <div class="feature-banner__stats">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}><span class="feature-banner__stat-label">{{ block.settings.label }}</span><span class="feature-banner__stat num">{% render 'tokens', text: block.settings.value, product: p %}</span></div>
          {%- endfor -%}
        </div>
        <span class="feature-banner__btn">{{ section.settings.button_label }}{% render 'icon', name: 'chev', size: 18 %}</span>
      </div>
      <div class="feature-banner__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 480px, 100vw', alt: section.settings.heading }}
        {%- elsif p.featured_media -%}
          {{ p.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', alt: p.title }}
        {%- else -%}
          <span class="pouch pouch--lg" style="--pouch: {{ section.settings.accent_color }};"><span class="pouch__brand">INNOCECT</span><span class="pouch__name">{{ p.title | default: 'NEW' }}</span></span>
        {%- endif -%}
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "注目商品バナー",
  "tag": "div",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "商品"
    },
    {
      "type": "text",
      "id": "label",
      "label": "ラベル",
      "default": "NEW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "ホエイプロテイン 3kg、登場。"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "説明",
      "default": "安さも、おいしさも、あきらめない。自社で試作を重ねた3kg・約100杯分のホエイプロテイン。"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタン",
      "default": "詳しく見る"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "画像"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#2A1A12"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "アクセント色",
      "default": "#F2D3A2"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "数字",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "項目",
          "default": "1杯あたり"
        },
        {
          "type": "text",
          "id": "value",
          "label": "値（{per} が使えます）",
          "default": "約{per}円"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "注目商品バナー",
      "blocks": [
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}
