<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    <div class="purposes">
      {%- for block in section.blocks -%}
        <a class="purpose card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="icon-circle">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
          <span class="purpose__text"><span class="purpose__title">{{ block.settings.title }}</span><span class="purpose__sub">{{ block.settings.text }}</span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "目的から探す",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "en",
      "label": "英字の小見出し",
