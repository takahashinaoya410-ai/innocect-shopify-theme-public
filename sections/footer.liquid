<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__cols">
      <div class="site-footer__brand">
        <span class="logo-text logo-text--light">{{ section.settings.logo_text }}</span>
        <p>{{ section.settings.brand_text }}</p>
        <div class="site-footer__social">
          {%- if settings.instagram_url != blank -%}<a class="icon-btn" href="{{ settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'insta', size: 22 %}</a>{%- endif -%}
          {%- if settings.x_url != blank -%}<a class="icon-btn" href="{{ settings.x_url }}" target="_blank" rel="noopener" aria-label="X">{% render 'icon', name: 'x', size: 18 %}</a>{%- endif -%}
          {%- if settings.line_url != blank -%}<a class="icon-btn" href="{{ settings.line_url }}" target="_blank" rel="noopener" aria-label="LINE">{% render 'icon', name: 'line', size: 22 %}</a>{%- endif -%}
        </div>
      </div>
      {%- for block in section.blocks -%}
        <nav class="site-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <p class="site-footer__heading">{{ block.settings.heading }}</p>
          <ul role="list">
            {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </nav>
      {%- endfor -%}
    </div>
    <div class="site-footer__bottom">
      <span>販売事業者：{{ settings.seller_name }}</span>
      <span class="num">© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "フッター",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "テキストロゴ", "default": "INNOCECT" },
    { "type": "textarea", "id": "brand_text", "label": "ブランド紹介", "default": "余計なコストを徹底的に削減する、国内ニュートリションブランド。毎日続けるものだから、低価格×高品質を。" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "リンク列",
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "ご利用ガイド" },
        { "type": "link_list", "id": "menu", "label": "メニュー", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
