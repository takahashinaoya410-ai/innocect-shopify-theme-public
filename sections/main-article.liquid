<article class="container container--text section">
  <p class="article__date num">{{ article.published_at | date: '%Y.%m.%d' }}</p>
  <h1 class="page-title">{{ article.title }}</h1>
  {%- if article.image -%}<div class="article__image">{{ article.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 760px, 100vw', alt: article.title }}</div>{%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a href="{{ blog.url }}">← {{ blog.title }}一覧へ</a></p>
</article>

{% schema %}
{ "name": "記事", "settings": [] }
{% endschema %}
