{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="お知らせ">
    <div class="announcement__inner">
      {%- for block in section.blocks -%}
        <p class="announcement__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "お知らせ帯",
  "class": "section-announcement",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "announcement",
      "name": "お知らせ",
      "settings": [
        { "type": "text", "id": "text", "label": "文言", "default": "定期便はずっと10%OFF ｜ 税込5,000円以上で送料無料" },
        { "type": "url", "id": "link", "label": "リンク" }
      ]
    }
  ],
  "presets": [{ "name": "お知らせ帯", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}
