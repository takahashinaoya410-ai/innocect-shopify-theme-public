<section class="section section--{{ section.settings.background }}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="container container--text">
    {% render 'section-head', en: section.settings.en, title: section.settings.title, lead: section.settings.lead %}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "テキスト",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "en",
      "label": "英字の小見出し"
    },
    {
      "type": "text",
      "id": "title",
      "label": "見出し"
    },
    {
      "type": "select",
      "id": "background",
      "label": "背景",
      "default": "white",
      "options": [
        {
          "value": "white",
          "label": "白"
        },
        {
          "value": "surface",
          "label": "グレー"
        },
        {
          "value": "tint",
          "label": "淡いグリーン"
        },
        {
          "value": "dark",
          "label": "濃い色"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "ページ内リンク用ID",
      "info": "例：reviews（半角英数字）"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文"
    }
  ],
  "presets": [
    {
      "name": "テキスト"
    }
  ]
}
{% endschema %}
