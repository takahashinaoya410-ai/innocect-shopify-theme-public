{%- comment -%} {% render 'stars', rating: 4.3, size: 14 %} {%- endcomment -%}
{%- liquid
  assign s = size | default: 14
  assign r = rating | default: 0 | times: 1.0 | round
-%}
<span class="stars" aria-hidden="true">
  {%- for i in (1..5) -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24"><path class="{% if i <= r %}star-on{% else %}star-off{% endif %}" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.1l-5.7 3.2 1.2-6.4L2.8 9.5l6.4-.8z"/></svg>
  {%- endfor -%}
</span>
