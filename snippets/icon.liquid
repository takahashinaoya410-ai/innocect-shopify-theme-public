{%- comment -%}
  使い方: {% render 'icon', name: 'cart', size: 20 %}
  線のアイコン（stroke=currentColor）。装飾用なので aria-hidden。
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  assign w = stroke | default: 1.8
-%}
<svg aria-hidden="true" focusable="false" class="icon icon-{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ w }}" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    {%- when 'cart' -%}<path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/><circle cx="10" cy="20.5" r="1.3"/><circle cx="18" cy="20.5" r="1.3"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'repeat' -%}<path d="M4 12a8 8 0 0 1 14-5.3M20 4v4h-4M20 12a8 8 0 0 1-14 5.3M4 20v-4h4"/>
    {%- when 'gift' -%}<path d="M4 11h16v10H4zM3 7h18v4H3zM12 7v14M12 7c-2-3-6-3-6 0M12 7c2-3 6-3 6 0"/>
    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l7-7"/>
    {%- when 'factory' -%}<path d="M3 21V10l6 4v-4l6 4V5h6v16z"/><path d="M7 17h2M12 17h2M17 17h2"/>
    {%- when 'yen' -%}<path d="M6 4l6 8 6-8M12 12v8M8 13h8M8 16.5h8"/>
    {%- when 'chev' -%}<path d="M9 6l6 6-6 6"/>
    {%- when 'chevd' -%}<path d="M6 9l6 6 6-6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'box' -%}<path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5L12 12l9-4.5M12 12v9"/>
    {%- when 'cup' -%}<path d="M7 4h10l-1.4 16H8.4z"/><path d="M7.5 9h9"/>
    {%- when 'spoon' -%}<ellipse cx="7" cy="7" rx="3.5" ry="4.5" transform="rotate(-45 7 7)"/><path d="M9.5 9.5L20 20"/>
    {%- when 'shake' -%}<path d="M8 3h8v3H8zM7 6h10l-1 15H8z"/><path d="M4 9l2 1M4 14l2-1M20 9l-2 1M20 14l-2-1"/>
    {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    {%- when 'moon' -%}<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>
    {%- when 'dumbbell' -%}<path d="M2 12h20M5 8v8M8 6v12M16 6v12M19 8v8"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>
    {%- when 'drop' -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
    {%- when 'bean' -%}<ellipse cx="12" cy="12" rx="6" ry="8.5" transform="rotate(35 12 12)"/><path d="M9 8c2 2 2 6 6 8"/>
    {%- when 'flask' -%}<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3"/><path d="M7.5 15h9"/>
    {%- when 'tag' -%}<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8" r="1.3"/>
    {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
    {%- when 'line' -%}<rect x="3" y="4" width="18" height="15" rx="5"/><path d="M7.5 9.5v4h2.5M12 9.5v4M14.5 13.5v-4l3 4v-4"/>
    {%- when 'insta' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".8"/>
    {%- when 'x' -%}<path d="M4 4l16 16M20 4L4 20"/>
    {%- when 'scale' -%}<path d="M4 20h16M6 20l2-12h8l2 12"/><circle cx="12" cy="5" r="2"/>
    {%- when 'sparkle' -%}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'filter' -%}<path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'trash' -%}<path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/>
    {%- else -%}<circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
