{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="ページ送り">
    {%- if paginate.previous -%}<a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="前のページ">‹</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}<a class="pagination__link num" href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}<span class="pagination__link is-current num" aria-current="page">{{ part.title }}</span>
      {%- else -%}<span class="pagination__gap">{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a class="pagination__link" href="{{ paginate.next.url }}" aria-label="次のページ">›</a>{%- endif -%}
  </nav>
{%- endif -%}
